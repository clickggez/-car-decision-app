@relation cardss_buy_balanced

@attribute gender {female,male}
@attribute age {20-23,24-26,27-30,31-40,41-50,51-60,'60+'}
@attribute children {0,1,2,3,'3+'}
@attribute education {bachelor,below_m3,m3,m6,master,phd,vocational}
@attribute occupation {business_owner,freelance,government,private,soe,student,trader}
@attribute family_size {1-2,3-4,'5+'}
@attribute housing_type {condo,house,townhome}
@attribute housing_status {family,own,rent}
@attribute parking {common,none,private}
@attribute income {15001-25000,25001-35000,35001-50000,50001-75000,'75000+',lt15000}
@attribute budget {1200001-1500000,'1500000+',500001-800000,800001-1200000,lt500000}
@attribute concern {battery_life,charging_station,electricity_cost,fuel_price,maintenance,resale_value,service_center}
@attribute purpose {avoid_public,commute,convenience,trade,travel}
@attribute purpose_housing {'avoid_public|family','avoid_public|own','avoid_public|rent','commute|family','commute|own','commute|rent','convenience|family','convenience|own','convenience|rent','trade|family','trade|own','trade|rent','travel|family','travel|own','travel|rent'}
@attribute charging_access {cannot,has,installable,unsure}
@attribute tco_awareness {much_cheaper,similar,slightly_cheaper,unknown}
@attribute incentive_awareness {aware_considered,aware_only,unknown}
@attribute income_budget_gap numeric
@attribute financial_readiness_gap numeric
@attribute intention numeric
@attribute attitude numeric
@attribute subjective_norm numeric
@attribute pbc_financial numeric
@attribute evt_job numeric
@attribute evt_move numeric
@attribute evt_child numeric
@attribute evt_income numeric
@attribute class {buy,not_buy}

